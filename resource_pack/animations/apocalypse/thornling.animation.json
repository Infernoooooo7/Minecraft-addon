{
  "format_version": "1.8.0",
  "animations": {
    "animation.apocalypse.thornling.walk": {
      "loop": true,
      "bones": {
        "right_leg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 35 * query.modified_move_speed",
            0,
            0
          ]
        },
        "left_leg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180) * 35 * query.modified_move_speed",
            0,
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 + 180) * 25 * query.modified_move_speed",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 25 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.apocalypse.thornling.idle": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            0,
            0,
            "math.sin(query.life_time * 120.00) * 4"
          ]
        }
      }
    },
    "animation.apocalypse.thornling.attack": {
      "loop": true,
      "bones": {
        "right_arm": {
          "rotation": [
            "-variable.attack_time * 150",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "-variable.attack_time * 150",
            0,
            0
          ]
        }
      }
    }
  }
}
