{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.apocalypse.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.apocalypse.glow": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.glow"
        }
      ],
      "textures": [
        "Texture.glow"
      ]
    },
    "controller.render.apocalypse.boss": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": 1.0,
        "g": 0.08,
        "b": 0.12,
        "a": "query.property('apocalypse:phase') == 3 ? 0.10 + math.abs(math.sin(query.life_time * 200)) * 0.12 : 0"
      }
    },
    "controller.render.apocalypse.hollow_shade": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.crimson"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('apocalypse:variant') == 'crimson' ? 1 : 0]"
      ]
    },
    "controller.render.apocalypse.hollow_shade_glow": {
      "arrays": {
        "textures": {
          "Array.glows": [
            "Texture.glow",
            "Texture.glow_crimson"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.glow"
        }
      ],
      "textures": [
        "Array.glows[query.property('apocalypse:variant') == 'crimson' ? 1 : 0]"
      ]
    },
    "controller.render.apocalypse.star_bolt": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.null"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[query.property('apocalypse:variant') == 'null' ? 1 : 0]"
      ]
    },
    "controller.render.apocalypse.star_bolt_glow": {
      "arrays": {
        "textures": {
          "Array.glows": [
            "Texture.glow",
            "Texture.glow_null"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.glow"
        }
      ],
      "textures": [
        "Array.glows[query.property('apocalypse:variant') == 'null' ? 1 : 0]"
      ]
    }
  }
}
