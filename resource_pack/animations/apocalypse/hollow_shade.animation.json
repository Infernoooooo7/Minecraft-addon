{
  "format_version": "1.8.0",
  "animations": {
    "animation.apocalypse.hollow_shade.idle": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            0,
            "math.sin(query.life_time * 150.00) * 1.4",
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "math.sin(query.life_time * 150.00) * 6",
            0,
            "math.sin(query.life_time * 116.13) * 4"
          ]
        },
        "left_arm": {
          "rotation": [
            "math.sin(query.life_time * 150.00 + 180) * 6",
            0,
            "math.sin(query.life_time * 116.13) * -4"
          ]
        },
        "body": {
          "rotation": [
            "math.sin(query.life_time * 150.00 + 90) * 3",
            0,
            0
          ]
        }
      }
    },
    "animation.apocalypse.hollow_shade.move": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "12 * query.modified_move_speed",
            0,
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "25 * query.modified_move_speed",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "25 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.apocalypse.hollow_shade.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.apocalypse.hollow_shade.attack": {
      "loop": true,
      "bones": {
        "right_arm": {
          "rotation": [
            "-variable.attack_time * 160",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "-variable.attack_time * 140",
            0,
            0
          ]
        }
      }
    }
  }
}
