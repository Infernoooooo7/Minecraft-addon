          ]
        },
        "leg_l1": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 90 + 300) * 25 * query.modified_move_speed",
            0
          ]
        },
        "leg_r2": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 90 + 240) * 25 * query.modified_move_speed",
            0
          ]
        },
        "leg_l2": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 90 + 60) * 25 * query.modified_move_speed",
